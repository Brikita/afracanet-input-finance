# Copy to .env in the project root. Never commit .env.
DATABASE_URL=sqlite:///./data/afracanet.db
# Use postgresql+psycopg://user:password@localhost:5432/afracanet for PostgreSQL.
PAYMENT_MODE=mock
AI_MODE=demo
# Local demo only. Set a unique value before using sandbox or hosting.
DEMO_ACCESS_CODE=afracanet-demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_EMAIL=
PAYPAL_LENDER_EMAIL=
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMS_MODE=demo
# Sandbox simulator only; real handset delivery is deliberately not enabled.
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Hosted deployments must explicitly allow their public hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Public verification keys only; private signing keys remain in the credit module.
CREDIT_TRUST_FILE=

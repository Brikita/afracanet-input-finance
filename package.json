{
  "name": "afracanet-input-finance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "playwright test",
    "check:types": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "check:format": "prettier --check src",
    "format": "prettier --write src vite.config.ts playwright.config.ts tests/browser package.json tsconfig.json index.html docs README.md AGENTS.md .github/workflows",
    "test:connected": "playwright test -c playwright.connected.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

FROM python:3.13-slim-bookworm AS plugin
RUN python -c "import hashlib; from pathlib import Path; from urllib.request import urlretrieve; urlretrieve('https://github.com/neo4j/graph-data-science/releases/download/2.13.4/neo4j-graph-data-science-2.13.4.jar', '/gds.jar'); assert hashlib.sha256(Path('/gds.jar').read_bytes()).hexdigest() == '10e072f73992224f1159f246c9d6a89da5f3b3434aeffa5be42647edda13a8d8'"

FROM neo4j:5.26.32-community
COPY --from=plugin /gds.jar /plugins/gds.jar
ENV NEO4J_server_memory_heap_initial__size=256m \
    NEO4J_server_memory_heap_max__size=512m \
    NEO4J_server_memory_pagecache_size=128m \
    NEO4J_server_directories_plugins=/plugins \
    NEO4J_dbms_security_procedures_unrestricted=gds.* \
    NEO4J_dbms_security_procedures_allowlist=gds.* \
    NEO4J_dbms_usage__report_enabled=false
# Keep the official entrypoint: it configures authentication and data ownership.
# Run as a PRIVATE Render service, mount /data, and never publish Bolt publicly.

# Credit intelligence owns these credentials. Never copy a payment-module .env here.
CREDIT_DATABASE_URL=sqlite:///./data/credit-workflow.db
CREDIT_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
CREDIT_DELIVERY_WORKER=0
CREDIT_SIGNING_KEY_FILE=
# JSON object mapping an authorized lender ID to its registered signing-key ID.
CREDIT_SIGNING_KEY_IDS={}
INPUT_FINANCE_URL=http://127.0.0.1:8000
INPUT_FINANCE_BROWSER_URL=http://127.0.0.1:5173/
VITE_CREDIT_API_URL=http://127.0.0.1:8001
# Use a dedicated SELECT-only PostgreSQL account for historical replay context.
REPLAY_DATABASE_URL=
WORKFLOW_NEO4J_URI=
WORKFLOW_NEO4J_USER=
WORKFLOW_NEO4J_PASSWORD=
WORKFLOW_NEO4J_DATABASE=neo4j
# Optional advisory summaries. Absence or failure returns unavailable, never a fallback decision.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
CREDIT_RECOMMENDATION_MODEL=

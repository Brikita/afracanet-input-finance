  "narrative": {
    "northStar": "Waterline",
    "overview": "Waterline makes agricultural finance readable through a deep teal navigation band, a pale blue ground, and white working surfaces. Compact typography and clearly separated records support repeated operational work. This credit extension preserves the user-selected world in [the shared direction](../Paypal/docs/WATERLINE.md) and applies it to evidence inspection and accountable lender review, as scoped in [the credit brief](docs/WATERLINE_CREDIT_BRIEF.md).\n\nThe system is calm, practical, and explicit about evidence. Retrieved relationships, authored balances, source records, advisory summaries, officer decisions, and delivery receipts retain separate labels. Outline SVG icons identify real actions. No raster asset ships in the credit interface; its relationship bars are rendered from retrieved counts. The execution module's allocation graphic and transaction drawer remain its own components rather than assumed features of this module.",
    "keyCharacteristics": [
      "Teal navigation and actions over a cool, pale ground.",
      "Flat white work surfaces with fine borders and modest rounding.",
      "DM Sans working text paired with Manrope headings and counts.",
      "Labelled relationship filters leading to inspectable source records.",
      "Responsive queue-to-case navigation with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Labelled Color Rule",
        "body": "Pair relationship and status colors with readable labels and counts; the hue alone never establishes a credit or transaction fact.",
        "section": "colors"
      },
      {
        "name": "The Amount Alignment Rule",
        "body": "Preserve tabular numerals and right-align comparable balances, with their currency and synthetic-history qualifiers visible.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Keep ordinary work panels flat; use borders and tonal insets to distinguish nested evidence.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use teal for shared navigation, actions, and labelled relationship bars.",
      "Do pair status and relationship colors with readable labels and counts.",
      "Do preserve tabular numerals, currency labels, and comparable balance alignment.",
      "Do keep working panels flat and use tonal insets for nested evidence.",
      "Do carry visible keyboard focus, accessible action labels, and reduced-motion behavior into new components.",
      "Do retain synthetic-data, public-context, advisory-only, and handoff qualifiers wherever they explain a record."
    ],
    "donts": [
      "Don't give ordinary operational panels decorative lift or replace established flat surfaces with gradients.",
      "Don't substitute decorative imagery for retrieved relationships or inspectable source records.",
      "Don't treat a relationship count, AI summary, lender decision, payment, and collection as interchangeable facts.",
      "Don't turn authored histories or public reference-point weather into calibrated risk scores or verified farmer outcomes.",
      "Don't imply production readiness through a success treatment or a recorded delivery receipt."
    ]
  }
}

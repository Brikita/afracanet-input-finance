  "narrative": {
    "northStar": "Aether Flow — connected financial life",
    "overview": "This authority covers the public Persuade world at `/about` and `/about.html`, under the product-page wrapper, including its Aether hero and image-reveal components. Forest ground, ivory reading, celadon connections and substantial Kenyan photographs give the explanation room to unfold. The user pinned the Aether Flow code and requested new fonts, web photographs and spacious scrolling; no new Impeccable concept roll or QUALITY BAR card applies.\n\nThis is a scoped visual world, not a global token migration. The working Operate application retains [root DESIGN.md](../../../DESIGN.md), root `.impeccable/design.json` and Waterline. Public CSS locally overrides shared variable names; do not transfer those overrides to the application root. This file's frontmatter owns public primitives; [the paired sidecar](.impeccable/design.json) owns extension metadata and component previews. The [six-block brief](../../../docs/PRODUCT_PAGE_BRIEF.md) owns page strategy; [PRODUCT.md](../../../PRODUCT.md) owns product truth.",
    "keyCharacteristics": [
      "A quiet living network behind readable centered hero text.",
      "Open editorial sections and large, credited contextual photographs.",
      "Flat tonal explorers with explicit controls and nearby limits.",
      "Automatic explanations that remain pausable and usable with reduced motion."
    ],
    "rules": [
      {
        "name": "The Scoped Forest Rule",
        "body": "Apply these tokens within the public wrapper; working financial screens continue to use Waterline.",
        "section": "colors"
      },
      {
        "name": "The Presentation Only Rule",
        "body": "Public controls reveal synthetic teaching data or a preserved provider snapshot; they never execute a financial action or call a financial API.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep public forest tokens and public fonts scoped to the two public routes.",
      "**Do** preserve visible focus, pause/resume, native selectors and offscreen/hidden suspension.",
      "**Do** use credited contextual photographs with their source terms and nearby captions.",
      "**Do** keep lender authority, teaching data, verified payment and physical collection visually and verbally distinct."
    ],
    "donts": [
      "**Don't** migrate the working application away from Waterline through this authority.",
      "**Don't** replace real provenance with fictional customer logos or imply that photographs show customers.",
      "**Don't** present authored community labels as Louvain output or browser PageRank as a calibrated borrower score.",
      "**Don't** turn advisory findings or one-off implementation values into rules for future surfaces."
    ]
  }
}
